# Backend Environment Variables
# ================================

# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
DB_DIALECT=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=hyperlocal_db

# Authentication
# Generate a strong secret key for production: 
# Use: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_change_in_production

# Google Maps API
# Get your key from: https://console.cloud.google.com/
# Required for: Geocoding, Places Autocomplete, Distance Matrix
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Cloudinary Configuration
# Get credentials from: https://cloudinary.com/
# Required for: Image uploads (product images, vendor logos, etc.)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Email Configuration (Gmail SMTP)
# For Gmail: Use an App Password, not your regular password
# Generate app password at: https://myaccount.google.com/apppasswords
# Required for: Email verification, order notifications
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password

# Frontend URL
# Used for building verification links and CORS configuration
FRONTEND_URL=http://localhost:3000

# Backend URL (used to build OAuth redirect URIs)
BACKEND_URL=http://localhost:5000

# Social Authentication
# ---------------------
# Google: https://console.cloud.google.com/ -> APIs & Services -> Credentials
#   Create an "OAuth 2.0 Client ID" of type "Web application".
#   Add http://localhost:3000 to "Authorized JavaScript origins".
#   The same Client ID is used by the frontend (REACT_APP_GOOGLE_CLIENT_ID).
GOOGLE_CLIENT_ID=your_google_oauth_client_id

# Facebook: https://developers.facebook.com/apps/ -> Settings -> Basic
#   Add Facebook Login product. Under Settings, allow http://localhost:3000.
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret

# GitHub: https://github.com/settings/developers -> New OAuth App
#   Homepage URL: http://localhost:3000
#   Authorization callback URL: http://localhost:5000/api/auth/github/callback
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret
