# Frontend Environment Variables

# API Configuration
# URL where the backend API server is running
REACT_APP_API_URL=http://localhost:5000/api

# Google Maps API
# Get your key from: https://console.cloud.google.com/
REACT_APP_GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Backend URL (used to redirect to /api/auth/github)
REACT_APP_BACKEND_URL=http://localhost:5000

# Social Authentication
# Google OAuth Client ID (same Web Application client used by the backend)
REACT_APP_GOOGLE_CLIENT_ID=your_google_oauth_client_id

# Facebook App ID (only the public App ID; the secret stays on the backend)
REACT_APP_FACEBOOK_APP_ID=your_facebook_app_id

# Set to "true" to show the "Continue with GitHub" button on login/register
REACT_APP_GITHUB_ENABLED=true
